  "findings": [
    {
      "id": "F01",
      "severity": "P1",
      "status": "confirmed_label_error",
      "title": "Agenda week/month/weekend labels silently drop reminders time constraint",
      "count": 30,
      "examples": [
        "train-r-0003",
        "dev-r-0000"
      ],
      "recommendation": "Retain both agenda sources and place requested unsupported reminder temporal phrase in unsupported_constraints. Add contrasts for today/tomorrow supported scopes, arbitrary date/month/range, and excluded reminders. Parent reports repair already planned."
    },
    {
      "id": "F02",
      "severity": "P2",
      "status": "coverage_risk",
      "title": "No ordinary conversation and weak everyday omitted-filter coverage",
      "details": "none has only prohibitions/exclusions (6 train,2 dev). rolling_days, unread:false, notes overview, calendar account targets, individual message conversations and availability without duration are absent. All standalone email_overview category rows require unread:true/account/count/time; all notes rows require query/month/count. Unfiltered calendar comes only from source-switch follow-ups; unfiltered reminders only from unsupported time/agenda. No standalone unfiltered email/messages/notes read. Only 3 train+1 dev supported day agenda examples, all typo surfaces. Dev reminder scopes omit today/upcoming.",
      "recommendation": "Add bounded natural everyday positives and minimal pairs that omit one filter, ordinary questions/thanks that permit no read, explicit unread:false contrasts, person/sender vs account, and no-duration availability."
    },
    {
      "id": "F03",
      "severity": "P2",
      "status": "naturalness_risk_not_incorrect_labels",
      "title": "Synthetic temporal pools make personal-history requests disproportionately implausible",
      "counts": {
        "future_email_messages_current_rows_train": 130,
        "future_email_messages_current_rows_dev": 13,
        "past_availability_train": 18,
        "past_availability_dev": 1,
        "explicit_future_history_source_labels_train": 132,
        "explicit_future_history_source_labels_dev": 10
      },
      "examples": [
        "train-r-0225",
        "train-r-0365",
        "train-r-0615",
        "train-r-0499",
        "dev-r-0059"
      ],
      "recommendation": "Use realistic past/present windows for normal mail/messages/notes, future windows for agenda/calendar availability, and retain a small explicit edge-case set. These labels preserve the actual requested time, so do not silently relabel future requests to past."
    },
    {
      "id": "F04",
      "severity": "P2",
      "status": "ambiguous_language_not_proven_wrong_label",
      "title": "Email from account surface conflates sender/account",
      "count": 23,
      "examples": [
        "train-r-0256",
        "train-r-0262"
      ],
      "details": "23 train rows say Give me N unread email highlights TIME from work/personal/research, yet label account. Research could be a sender/team; literal account text alone does not establish intended filter. No positive person-sender email search contrast exists.",
      "recommendation": "Say from my research account / in my work inbox and add email record searches from named senders, preserving sender as query."
    },
    {
      "id": "F05",
      "severity": "P3",
      "status": "contract_ambiguity",
      "title": "Capability summary omits free_time minutes although all 71 availability labels use it",
      "details": "router-system says calendar query/account/time; other instruction permits explicit minutes and schema supports minutes. Existing targets consistently label explicit durations, but summary is incomplete.",
      "recommendation": "Explicitly mention calendar free_time minutes in the capabilities summary."
    },
    {
      "id": "F06",
      "severity": "P2",
      "status": "coverage_risk",
      "title": "Boundary/context robustness exceeds observed template coverage",
      "details": "90 train templates (3 per category) and 30 dev templates (one per category) cover 30 categories. Same-source cases only replace email/message count or calendar time; source switches only email-to-calendar/calendar-to-messages. No prior-tool role data, adversarial previous-source instructions, same-source retained unsupported/excluded filters, ordinary conversation interruption, selective multi-source removal, personal-vs-public calendar/read ambiguity, or mixed read+inline-draft source grounding examples observed.",
      "recommendation": "Add a bounded set of natural minimal pairs for documented authorization, retain/reset and draft/read/send boundaries rather than only increasing slot combinations."
    },
    {
      "id": "F07",
      "severity": "P3",
      "status": "schema_limitation",
      "title": "JSON schema is permissive across semantic invariants",
      "details": "Schema allows empty/multiple/partial time selectors, domain-inapplicable fields and nonempty sources on inline/none/unsupported. Independent static checks found none of these errors in 1540 current targets. Schema validity alone cannot establish routing correctness.",
      "recommendation": "Keep separate semantic validation or tighten schema where appropriate; no current target repair is required for this finding."
    }
  ],
